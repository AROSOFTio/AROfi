# AroFi desktop Docker environment template.
# Copy values into .env.desktop.local. NEVER commit real credentials.
# .env.desktop.local is ignored by Git via .env.*.local.
#
# Desktop is LOCAL UI/DATA ONLY.
# Real MikroTik onboarding, RADIUS, ioTec and Yo! Uganda tests run on dev.arofi.net.

AROFI_DEPLOYMENT_ENV=desktop

APP_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3000
PORTAL_BASE_URL=http://localhost:3000/portal
API_PUBLIC_HOST=localhost:3000
PORTAL_PUBLIC_HOST=localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ADMIN_ORIGINS=http://localhost:3000

# Neutralized router-facing targets. docker-compose.desktop.yml also pins these
# values so a local env typo cannot point the desktop runtime at production.
MIKROTIK_CALLBACK_HTTP_URL=http://127.0.0.1:18080
RADIUS_PUBLIC_HOST=127.0.0.1
VPN_SERVER_IP=127.0.0.1
ROUTER_PROBE_ENABLED=false
ROUTER_ALERTS_ENABLED=false
ACCESS_WORKERS_ENABLED=false
RADIUS_DB_LISTEN_ENABLED=false
RADIUS_DISCONNECT_ENABLED=false

# Keep RouterOS 6.x compatibility unchanged.
RADIUS_REQUIRE_MESSAGE_AUTHENTICATOR=no

# -----------------------------
# Email / login OTP only
# -----------------------------
SMTP_HOST=mail.arofi.net
SMTP_PORT=587
SMTP_USER=local@arofi.net
SMTP_PASS=REPLACE_WITH_REAL_LOCAL_MAILBOX_PASSWORD
SMTP_FROM_NAME=AroFi
SMTP_FROM_EMAIL=local@arofi.net
SUPPORT_EMAIL=support@arofi.net
SMTP_ALLOW_SELF_SIGNED_CERT=false

# Live payment credentials deliberately do NOT belong in desktop.
# docker-compose.desktop.yml blanks ioTec and Yo! Uganda credentials inside the
# API container even if someone accidentally puts them in .env.desktop.local.
IOTEC_CLIENT_ID=
IOTEC_CLIENT_SECRET=
IOTEC_WALLET_ID=
IOTEC_WEBHOOK_SECRET=
YO_UGANDA_USERNAME=
YO_UGANDA_PASSWORD=
YO_UGANDA_WEBHOOK_SECRET=

# Direct MTN/Airtel integrations remain placeholders until direct APIs are issued.
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=
MTN_MOMO_COLLECTION_API_USER=
MTN_MOMO_COLLECTION_API_KEY=
MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MTN_MOMO_DISBURSEMENT_API_USER=
MTN_MOMO_DISBURSEMENT_API_KEY=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_PUBLIC_KEY=

# Pesapal is not part of the approved AroFi payment-provider set.
