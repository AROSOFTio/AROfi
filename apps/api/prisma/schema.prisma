generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PackageStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PricingStrategy {
  FIXED
}

enum VoucherBatchStatus {
  DRAFT
  ACTIVE
  EXHAUSTED
  CANCELLED
}

enum VoucherStatus {
  GENERATED
  PRINTED
  SOLD
  REDEEMED
  EXPIRED
  VOID
  VOIDED
}

enum BillingChannel {
  MOBILE_MONEY
  VOUCHER
  WALLET_ADJUSTMENT
  FLOAT_TRANSFER
  COMMISSION
  DISBURSEMENT
  SYSTEM
}

enum BillingTransactionType {
  MOBILE_MONEY_SALE
  VOUCHER_SALE
  VOUCHER_REDEMPTION
  WALLET_ADJUSTMENT
  AGENT_FLOAT_TOPUP
  AGENT_FLOAT_RETURN
  AGENT_COMMISSION
  AGENT_DISBURSEMENT
}

enum BillingTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum FeeSettingSource {
  GLOBAL_DEFAULT
  TENANT_OVERRIDE
}

enum PaymentProvider {
  MTN_MOMO_DIRECT
  AIRTEL_MONEY_DIRECT
  AGGREGATOR
}

enum PaymentMethod {
  MOBILE_MONEY
  CARD
}

enum PaymentNetwork {
  MTN
  AIRTEL
  UNKNOWN
}

enum PaymentStatus {
  INITIATED
  PENDING
  COMPLETED
  FAILED
  INDETERMINATE
  CANCELLED
  EXPIRED
}

enum PaymentEventType {
  REQUESTED
  STATUS_CHECK
  WEBHOOK_RECEIVED
  WEBHOOK_PROCESSED
  WEBHOOK_REJECTED
  STATE_TRANSITION
  ACTIVATION_POSTED
  ACTIVATION_FAILED
}

enum RouterVendor {
  MIKROTIK
}

enum RouterConnectionMode {
  ROUTEROS_API
  ROUTEROS_API_SSL
}

enum RouterStatus {
  PENDING
  HEALTHY
  DEGRADED
  OFFLINE
}

enum RadiusClientStatus {
  ACTIVE
  DISABLED
}

enum RadiusEventType {
  ACCESS_REQUEST
  ACCESS_ACCEPT
  ACCESS_REJECT
  ACCOUNTING_START
  ACCOUNTING_INTERIM
  ACCOUNTING_STOP
  COA_REQUEST
  DISCONNECT_REQUEST
}

enum SessionStatus {
  ACTIVE
  CLOSED
  STALE
}

enum WalletOwnerType {
  TENANT
  AGENT
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerTransactionType {
  SALE
  WALLET_ADJUSTMENT
  REDEMPTION
  FLOAT_TRANSFER
  COMMISSION
  DISBURSEMENT
}

enum AgentType {
  FIELD_AGENT
  RESELLER
}

enum AgentStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum CommissionStatus {
  ACCRUED
  SETTLED
  REVERSED
}

enum SettlementStatus {
  DRAFT
  READY
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum DisbursementMethod {
  MOBILE_MONEY
  BANK_TRANSFER
  CASH
  MANUAL
}

enum DisbursementStatus {
  PENDING_APPROVAL
  PENDING_NUMBER_APPROVAL
  FLAGGED_FOR_REVIEW
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
  CANCELLED
}

enum PayoutNumberStatus {
  PENDING_VERIFICATION
  PENDING_ADMIN_APPROVAL
  VERIFIED
  DISABLED
}

enum PayoutNumberChangeStatus {
  PENDING
  PENDING_VERIFICATION
  PENDING_ADMIN_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum PackageActivationSource {
  MOBILE_MONEY
  VOUCHER
}

enum PackageActivationStatus {
  PENDING
  ACTIVE
  EXPIRED
  FAILED
  REVOKED
  SUSPENDED
  QUOTA_EXHAUSTED
}

enum RouterVerificationStatus {
  SCRIPT_GENERATED
  OPERATOR_APPLIED
  VERIFIED
  FAILED
}

enum RouterOnboardingStatus {
  NOT_STARTED
  SCRIPT_GENERATED
  WAITING_FOR_ROUTER
  RADIUS_SEEN
  ACCOUNTING_SEEN
  VERIFIED_ONLINE
  CONFIG_ERROR
}

enum RouterScriptMode {
  SAFE_EXISTING_ROUTER
  FRESH_FULL_HOTSPOT
  FRESH_FULL_CAPTIVE_WIFI
}

enum RadiusCredentialStatus {
  ACTIVE
  DISABLED
  EXPIRED
  REVOKED
}

enum DeviceBindingResetStatus {
  COMPLETED
  REJECTED
}

enum ReconnectionStatus {
  ALLOWED
  DENIED
  STALE_SESSION_CLEARED
  LOGIN_PAYLOAD_ISSUED
}

enum SuspiciousAccessAttemptType {
  SECOND_DEVICE
  CONCURRENT_SESSION
  MISSING_MAC
}

enum DisconnectionStatus {
  REQUESTED
  SUCCESS
  FAILED
  NOT_SUPPORTED
}

enum DisconnectionMethod {
  RADIUS_DISCONNECT
  ROUTEROS_API
  AUTH_DISABLE_ONLY
}

enum AuditSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum FeatureLimitCategory {
  CATALOG
  NETWORK
  SALES
  SUPPORT
  OPERATIONS
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  PENDING_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum SupportTicketChannel {
  PORTAL
  EMAIL
  PHONE
  INTERNAL
}

model Tenant {
  id                  String               @id @default(uuid())
  name                String
  domain              String?              @unique
  logoUrl             String?
  brandColor          String?
  portalTemplate      String   @default("classic")
  supportPhone        String?
  supportEmail        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  users               User[]
  agents              Agent[]
  hotspots            Hotspot[]
  packages            Package[]
  voucherBatches      VoucherBatch[]
  vouchers            Voucher[]
  voucherTemplates    VoucherTemplate[]
  wallets             Wallet[]
  billingTransactions BillingTransaction[]
  ledgerTransactions  LedgerTransaction[]
  ledgerEntries       LedgerEntry[]
  agentCommissions    AgentCommission[]
  settlements         Settlement[]
  disbursements       Disbursement[]
  voucherRedemptions  VoucherRedemption[]
  payments            Payment[]
  paymentWebhooks     PaymentWebhook[]
  paymentProviderConfigs PaymentProviderConfig[]
  packageActivations  PackageActivation[]
  routerGroups        RouterGroup[]
  routers             Router[]
  routerHealthChecks  RouterHealthCheck[]
  radiusClients       RadiusClient[]
  nasClients          NasClient[]
  radiusEvents        RadiusEvent[]
  networkSessions     NetworkSession[]
  featureLimits       FeatureLimit[]
  supportTickets      SupportTicket[]
  auditLogs           AuditLog[]
  radiusCredentials   RadiusCredential[]
  deviceBindingResets DeviceBindingReset[]
  reconnectionLogs    ReconnectionLog[]
  suspiciousAttempts  SuspiciousAccessAttempt[]
  voucherPrintLogs    VoucherPrintLog[]
  tenantSettings      TenantSetting?
  payoutProfile       TenantPayoutProfile?
  payoutNumbers       TenantPayoutNumber[]
  payoutNumberChangeRequests TenantPayoutNumberChangeRequest[]
  disconnectionAttempts DisconnectionAttempt[]
}

model PlatformSetting {
  id                         String   @id @default("global")
  mobileMoneyFeeBps          Int      @default(700)
  voucherFeeBps              Int      @default(200)
  minimumWithdrawalUgx       Int      @default(0)
  withdrawalFeeBps           Int      @default(0)
  withdrawalFlatFeeUgx       Int      @default(0)
  requireWithdrawalApproval  Boolean  @default(false)
  instantWithdrawalsEnabled  Boolean  @default(true)
  requireApprovalForFirstWithdrawal Boolean @default(false)
  requireApprovalAboveAmountUgx Int?
  failedSecretAttemptsBeforeLock Int @default(5)
  withdrawalLockMinutes      Int      @default(30)
  payoutNumberChangeRequiresApproval Boolean @default(true)
  maxPayoutNumbers           Int      @default(2)
  allowedPaymentNetworks     PaymentNetwork[] @default([MTN])
  mtnCollectionProvider      PaymentProvider @default(MTN_MOMO_DIRECT)
  airtelCollectionProvider   PaymentProvider @default(AGGREGATOR)
  mtnDisbursementProvider    PaymentProvider @default(MTN_MOMO_DIRECT)
  airtelDisbursementProvider PaymentProvider @default(AGGREGATOR)
  routerAutoConnectEnabled   Boolean  @default(true)
  captivePortalFallbackMessage String @default("Payment confirmed, but automatic connection failed. Tap Connect Now or open your session.")
  supportPhone               String?
  supportEmail               String?
  supportUrl                 String?
  voucherTemplateDefaultStyle String  @default("signal")
  auditLoggingEnabled        Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String[]
  users       User[]
}

model User {
  id                     String            @id @default(uuid())
  email                  String            @unique
  password               String
  firstName              String?
  lastName               String?
  roleId                 String
  role                   Role              @relation(fields: [roleId], references: [id])
  tenantId               String?
  tenant                 Tenant?           @relation(fields: [tenantId], references: [id])
  isActive               Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  generatedVoucherBatches VoucherBatch[]   @relation("VoucherBatchGenerator")
  voucherRedemptions     VoucherRedemption[] @relation("VoucherRedemptionActor")
}

model Agent {
  id                String            @id @default(uuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  code              String
  name              String
  phoneNumber       String
  email             String?
  type              AgentType         @default(FIELD_AGENT)
  status            AgentStatus       @default(ACTIVE)
  territory         String?
  commissionRateBps Int               @default(500)
  floatLimitUgx     Int               @default(0)
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  wallet            Wallet?
  transactions      BillingTransaction[]
  commissions       AgentCommission[]
  settlements       Settlement[]
  disbursements     Disbursement[]

  @@unique([tenantId, code])
  @@unique([tenantId, phoneNumber])
  @@index([tenantId, status])
}

model Hotspot {
  id                 String              @id @default(uuid())
  name               String
  nasIpAddress       String?
  secret             String?
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  voucherRedemptions VoucherRedemption[]
  packageActivations PackageActivation[]
  routers            Router[]
  radiusEvents       RadiusEvent[]
  networkSessions    NetworkSession[]
}

model RouterGroup {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  code        String
  description String?
  region      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  routers     Router[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
}

model Router {
  id                    String               @id @default(uuid())
  tenantId              String
  tenant                Tenant               @relation(fields: [tenantId], references: [id])
  groupId               String?
  group                 RouterGroup?         @relation(fields: [groupId], references: [id])
  hotspotId             String?
  hotspot               Hotspot?             @relation(fields: [hotspotId], references: [id])
  name                  String
  identity              String?
  vendor                RouterVendor         @default(MIKROTIK)
  host                  String
  apiPort               Int                  @default(8728)
  connectionMode        RouterConnectionMode @default(ROUTEROS_API)
  username              String
  passwordCiphertext    String
  sharedSecretCiphertext String
  siteLabel             String?
  model                 String?
  serialNumber          String?
  routerOsVersion       String?
  status                RouterStatus         @default(PENDING)
  healthMessage         String?
  lastSeenAt            DateTime?
  lastHealthCheckAt     DateTime?
  lastLatencyMs         Int?
  activeSessionCount    Int                  @default(0)
  lastProvisionedAt     DateTime?
  verificationStatus    RouterVerificationStatus @default(SCRIPT_GENERATED)
  onboardingStatus      RouterOnboardingStatus @default(NOT_STARTED)
  lastScriptMode        RouterScriptMode       @default(SAFE_EXISTING_ROUTER)
  registrationKey       String                 @unique @default(uuid())
  verifiedAt            DateTime?
  scriptGeneratedAt     DateTime?
  lastRadiusSignalAt    DateTime?
  lastAccountingSignalAt DateTime?
  lastAuthSignalAt      DateTime?
  radiusNasIpAddress    String?
  hotspotServerName     String?
  portalWalledGardenHosts String[]
  ttlAntiTetheringEnabled Boolean @default(false)
  tags                  String[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  radiusClient          RadiusClient?
  nasClient             NasClient?
  healthChecks          RouterHealthCheck[]
  radiusEvents          RadiusEvent[]
  sessions              NetworkSession[]

  @@unique([tenantId, host])
  @@index([tenantId, status])
  @@index([groupId])
}

model RouterHealthCheck {
  id               String       @id @default(uuid())
  tenantId         String
  tenant           Tenant       @relation(fields: [tenantId], references: [id])
  routerId         String
  router           Router       @relation(fields: [routerId], references: [id])
  status           RouterStatus
  latencyMs        Int?
  message          String?
  cpuUsagePercent  Int?
  memoryUsagePercent Int?
  activeUsers      Int?
  rawPayload       Json?
  checkedAt        DateTime     @default(now())

  @@index([tenantId, checkedAt])
  @@index([routerId, checkedAt])
}

model RadiusClient {
  id               String             @id @default(uuid())
  tenantId         String
  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  routerId         String             @unique
  router           Router             @relation(fields: [routerId], references: [id])
  shortName        String
  ipAddress        String
  secretCiphertext String
  status           RadiusClientStatus @default(ACTIVE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([tenantId, status])
}

model RadiusEvent {
  id                String          @id @default(uuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  routerId          String?
  router            Router?         @relation(fields: [routerId], references: [id])
  hotspotId         String?
  hotspot           Hotspot?        @relation(fields: [hotspotId], references: [id])
  sessionId         String?
  session           NetworkSession? @relation(fields: [sessionId], references: [id])
  eventType         RadiusEventType
  username          String?
  customerReference String?
  phoneNumber       String?
  macAddress        String?
  ipAddress         String?
  nasIpAddress      String?
  authMethod        String?
  responseCode      String?
  message           String?
  payload           Json?
  createdAt         DateTime        @default(now())

  @@index([tenantId, createdAt])
  @@index([routerId, createdAt])
  @@index([sessionId, createdAt])
}

model NetworkSession {
  id                  String             @id @default(uuid())
  tenantId            String
  tenant              Tenant             @relation(fields: [tenantId], references: [id])
  routerId            String?
  router              Router?            @relation(fields: [routerId], references: [id])
  hotspotId           String?
  hotspot             Hotspot?           @relation(fields: [hotspotId], references: [id])
  activationId        String?
  activation          PackageActivation? @relation(fields: [activationId], references: [id])
  voucherRedemptionId String?
  voucherRedemption   VoucherRedemption? @relation(fields: [voucherRedemptionId], references: [id])
  radiusSessionId     String
  status              SessionStatus      @default(ACTIVE)
  username            String
  customerReference   String?
  phoneNumber         String?
  macAddress          String?
  ipAddress           String?
  nasIpAddress        String?
  packageName         String?
  startedAt           DateTime           @default(now())
  endedAt             DateTime?
  sessionTimeSeconds  Int                @default(0)
  inputOctets         BigInt             @default(0)
  outputOctets        BigInt             @default(0)
  lastAccountingAt    DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  radiusEvents        RadiusEvent[]

  @@unique([tenantId, radiusSessionId])
  @@index([tenantId, status, startedAt])
  @@index([routerId, status])
}

model Package {
  id                  String               @id @default(uuid())
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  name                String
  code                String
  description         String?
  durationMinutes     Int
  dataLimitMb         Int?
  deviceLimit         Int?
  downloadSpeedKbps   Int?
  uploadSpeedKbps     Int?
  isFeatured          Boolean              @default(false)
  status              PackageStatus        @default(DRAFT)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  prices              PackagePrice[]
  voucherBatches      VoucherBatch[]
  vouchers            Voucher[]
  voucherTemplates    VoucherTemplate[]
  billingTransactions BillingTransaction[]
  voucherRedemptions  VoucherRedemption[]
  payments            Payment[]
  packageActivations  PackageActivation[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model PackagePrice {
  id          String          @id @default(uuid())
  packageId   String
  package     Package         @relation(fields: [packageId], references: [id])
  amountUgx   Int
  currency    String          @default("UGX")
  strategy    PricingStrategy @default(FIXED)
  isDefault   Boolean         @default(true)
  startsAt    DateTime        @default(now())
  endsAt      DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([packageId, startsAt])
}

model VoucherTemplate {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  packageId       String?
  package         Package?  @relation(fields: [packageId], references: [id])
  name            String
  code            String
  prefix          String
  defaultQuantity Int       @default(100)
  faceValueUgx    Int?
  expiresAfterDays Int?
  isDefault       Boolean   @default(false)
  isActive        Boolean   @default(true)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  batches         VoucherBatch[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model VoucherBatch {
  id                String            @id @default(uuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  packageId         String
  package           Package           @relation(fields: [packageId], references: [id])
  templateId        String?
  template          VoucherTemplate?  @relation(fields: [templateId], references: [id])
  generatedByUserId String?
  generatedByUser   User?             @relation("VoucherBatchGenerator", fields: [generatedByUserId], references: [id])
  batchNumber       String            @unique
  prefix            String
  quantity          Int
  faceValueUgx      Int
  expiresAt         DateTime?
  status            VoucherBatchStatus @default(ACTIVE)
  notes             String?
  lastPrintedAt     DateTime?
  exportedAt        DateTime?
  printCount        Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  vouchers          Voucher[]
  printLogs         VoucherPrintLog[]

  @@index([tenantId, createdAt])
}

model Voucher {
  id                  String               @id @default(uuid())
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  batchId             String
  batch               VoucherBatch         @relation(fields: [batchId], references: [id])
  packageId           String
  package             Package              @relation(fields: [packageId], references: [id])
  code                String               @unique
  serialNumber        String               @unique
  faceValueUgx        Int
  status              VoucherStatus        @default(GENERATED)
  soldAt              DateTime?
  redeemedAt          DateTime?
  expiresAt           DateTime?
  soldToReference     String?
  customerReference   String?
  printCount          Int                  @default(0)
  lastPrintedAt       DateTime?
  exportedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  billingTransactions BillingTransaction[]
  redemption          VoucherRedemption?

  @@index([tenantId, status])
}

model NasClient {
  id          Int      @id @default(autoincrement())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  routerId    String?  @unique
  router      Router?  @relation(fields: [routerId], references: [id])
  nasname     String   @db.VarChar(128)
  shortname   String   @db.VarChar(32)
  type        String   @default("mikrotik") @db.VarChar(30)
  ports       Int?
  secret      String   @db.VarChar(128)
  server      String?  @db.VarChar(64)
  community   String?  @db.VarChar(50)
  description String?  @db.VarChar(200)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("nas")
  @@unique([nasname, shortname])
  @@index([tenantId])
  @@index([routerId])
}

model Wallet {
  id                  String               @id @default(uuid())
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  ownerType           WalletOwnerType      @default(TENANT)
  ownerReference      String
  agentId             String?              @unique
  agent               Agent?               @relation(fields: [agentId], references: [id])
  currency            String               @default("UGX")
  balanceUgx          Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  ledgerTransactions  LedgerTransaction[]
  ledgerEntries       LedgerEntry[]
  billingTransactions BillingTransaction[]
  commissions         AgentCommission[]
  settlements         Settlement[]
  disbursements       Disbursement[]

  @@unique([tenantId, ownerType, ownerReference])
  @@index([agentId])
}

model BillingTransaction {
  id                  String                   @id @default(uuid())
  tenantId            String
  tenant              Tenant                   @relation(fields: [tenantId], references: [id])
  walletId            String?
  wallet              Wallet?                  @relation(fields: [walletId], references: [id])
  agentId             String?
  agent               Agent?                   @relation(fields: [agentId], references: [id])
  packageId           String?
  package             Package?                 @relation(fields: [packageId], references: [id])
  voucherId           String?
  voucher             Voucher?                 @relation(fields: [voucherId], references: [id])
  ledgerTransactionId String?                  @unique
  ledgerTransaction   LedgerTransaction?       @relation(fields: [ledgerTransactionId], references: [id])
  channel             BillingChannel
  type                BillingTransactionType
  status              BillingTransactionStatus @default(COMPLETED)
  grossAmountUgx      Int
  feeAmountUgx        Int                      @default(0)
  netAmountUgx        Int                      @default(0)
  feeBasisPoints      Int                      @default(0)
  feeSource           FeeSettingSource?
  customerReference   String?
  externalReference   String?                  @unique
  paymentProvider     String?
  metadata            Json?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  payment             Payment?
  sourceCommission    AgentCommission?         @relation("AgentCommissionSource")
  payoutCommission    AgentCommission?         @relation("AgentCommissionPayout")
  disbursement        Disbursement?

  @@index([tenantId, createdAt])
  @@index([type, status])
  @@index([agentId, createdAt])
}

model LedgerTransaction {
  id                  String               @id @default(uuid())
  tenantId            String?
  tenant              Tenant?              @relation(fields: [tenantId], references: [id])
  walletId            String?
  wallet              Wallet?              @relation(fields: [walletId], references: [id])
  reference           String               @unique
  type                LedgerTransactionType
  channel             BillingChannel
  description         String
  grossAmountUgx      Int                  @default(0)
  feeAmountUgx        Int                  @default(0)
  netAmountUgx        Int                  @default(0)
  feeBasisPoints      Int                  @default(0)
  feeSource           FeeSettingSource?
  sourceType          String?
  sourceId            String?
  metadata            Json?
  createdAt           DateTime             @default(now())
  entries             LedgerEntry[]
  billingTransaction  BillingTransaction?

  @@index([tenantId, createdAt])
}

model LedgerEntry {
  id                  String            @id @default(uuid())
  ledgerTransactionId String
  ledgerTransaction   LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id])
  tenantId            String?
  tenant              Tenant?           @relation(fields: [tenantId], references: [id])
  walletId            String?
  wallet              Wallet?           @relation(fields: [walletId], references: [id])
  accountCode         String
  direction           LedgerDirection
  amountUgx           Int
  memo                String?
  createdAt           DateTime          @default(now())

  @@index([tenantId, createdAt])
  @@index([walletId, createdAt])
}

model VoucherRedemption {
  id                String    @id @default(uuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  voucherId         String    @unique
  voucher           Voucher   @relation(fields: [voucherId], references: [id])
  packageId         String
  package           Package   @relation(fields: [packageId], references: [id])
  redeemedByUserId  String?
  redeemedByUser    User?     @relation("VoucherRedemptionActor", fields: [redeemedByUserId], references: [id])
  hotspotId         String?
  hotspot           Hotspot?  @relation(fields: [hotspotId], references: [id])
  customerReference String?
  sessionReference  String?
  boundMacAddress   String?
  firstSeenIp       String?
  firstSeenAt       DateTime?
  userAgent         String?
  routerId          String?
  hotspotServerName String?
  createdAt         DateTime  @default(now())
  activation        PackageActivation?
  networkSessions   NetworkSession[]

  @@index([tenantId, createdAt])
}

model Payment {
  id                  String             @id @default(uuid())
  tenantId            String
  tenant              Tenant             @relation(fields: [tenantId], references: [id])
  packageId           String
  package             Package            @relation(fields: [packageId], references: [id])
  billingTransactionId String?           @unique
  billingTransaction  BillingTransaction? @relation(fields: [billingTransactionId], references: [id])
  provider            PaymentProvider    @default(MTN_MOMO_DIRECT)
  method              PaymentMethod      @default(MOBILE_MONEY)
  network             PaymentNetwork     @default(UNKNOWN)
  status              PaymentStatus      @default(INITIATED)
  amountUgx           Int
  currency            String             @default("UGX")
  phoneNumber         String
  normalizedPhone     String?
  customerReference   String?
  externalReference   String             @unique
  providerReference   String?            @unique
  idempotencyKey      String             @unique
  statusToken         String?            @unique
  providerStatus      String?
  statusMessage       String?
  requestPayload      Json?
  responsePayload     Json?
  metadata            Json?
  initiatedAt         DateTime           @default(now())
  completedAt         DateTime?
  failedAt            DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  webhooks            PaymentWebhook[]
  activation          PackageActivation?

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
  @@index([tenantId, network, status, createdAt])
}

model PaymentWebhook {
  id                 String         @id @default(uuid())
  tenantId           String?
  tenant             Tenant?        @relation(fields: [tenantId], references: [id])
  paymentId          String?
  payment            Payment?       @relation(fields: [paymentId], references: [id])
  provider           PaymentProvider @default(MTN_MOMO_DIRECT)
  network            PaymentNetwork?
  eventType          PaymentEventType
  status             String?
  idempotencyKey     String?         @unique
  externalReference  String?
  providerReference  String?
  verificationStatus String?
  headers            Json
  payload            Json
  notes              String?
  isProcessed        Boolean        @default(false)
  processedAt        DateTime?
  createdAt          DateTime       @default(now())

  @@index([paymentId, createdAt])
  @@index([externalReference, createdAt])
  @@index([provider, providerReference, createdAt])
}

model PaymentProviderConfig {
  id                   String          @id @default(uuid())
  tenantId             String?
  tenant               Tenant?         @relation(fields: [tenantId], references: [id])
  network              PaymentNetwork
  collectionProvider   PaymentProvider
  disbursementProvider PaymentProvider
  mode                 String          @default("sandbox")
  currency             String          @default("UGX")
  commissionBps        Int             @default(0)
  minimumPayoutUgx     Int             @default(0)
  requirePayoutApproval Boolean        @default(true)
  allowedPrefixes      String[]
  lastSuccessfulCollectionAt DateTime?
  lastSuccessfulDisbursementAt DateTime?
  webhookHealthStatus  String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@unique([tenantId, network])
}

model PackageActivation {
  id                  String                 @id @default(uuid())
  tenantId            String
  tenant              Tenant                 @relation(fields: [tenantId], references: [id])
  packageId           String
  package             Package                @relation(fields: [packageId], references: [id])
  paymentId           String?                @unique
  payment             Payment?               @relation(fields: [paymentId], references: [id])
  voucherRedemptionId String?                @unique
  voucherRedemption   VoucherRedemption?     @relation(fields: [voucherRedemptionId], references: [id])
  hotspotId           String?
  hotspot             Hotspot?               @relation(fields: [hotspotId], references: [id])
  source              PackageActivationSource
  status              PackageActivationStatus @default(ACTIVE)
  customerReference   String?
  accessPhoneNumber   String?
  durationMinutes     Int
  dataLimitMb         Int?
  deviceLimit         Int?
  downloadSpeedKbps   Int?
  uploadSpeedKbps     Int?
  radiusUsername      String?                @unique
  radiusPassword      String?
  boundMacAddress     String?
  firstSeenIp         String?
  firstSeenAt         DateTime?
  routerId            String?
  hotspotServerName   String?
  lastReconnectAt     DateTime?
  deviceResetCount    Int                    @default(0)
  usedBytes           BigInt                 @default(0)
  quotaExhaustedAt    DateTime?
  startedAt           DateTime               @default(now())
  endsAt              DateTime
  metadata            Json?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  sessions            NetworkSession[]
  radiusCredential    RadiusCredential?
  deviceBindingResets DeviceBindingReset[]
  reconnectionLogs    ReconnectionLog[]
  suspiciousAttempts  SuspiciousAccessAttempt[]
  disconnectionAttempts DisconnectionAttempt[]

  @@index([tenantId, status, endsAt])
  @@index([accessPhoneNumber, status])
  @@index([tenantId, boundMacAddress, status])
  @@index([routerId, boundMacAddress])
}

model DisconnectionAttempt {
  id             String              @id @default(uuid())
  tenantId       String
  tenant         Tenant              @relation(fields: [tenantId], references: [id])
  activationId   String?
  activation     PackageActivation?  @relation(fields: [activationId], references: [id])
  sessionId      String?
  method         DisconnectionMethod
  status         DisconnectionStatus @default(REQUESTED)
  routerId       String?
  username       String?
  macAddress     String?
  radiusSessionId String?
  message        String?
  payload        Json?
  attemptedAt    DateTime            @default(now())
  completedAt    DateTime?

  @@index([tenantId, attemptedAt])
  @@index([activationId, attemptedAt])
  @@index([status, attemptedAt])
}

model RadiusCredential {
  id             String                 @id @default(uuid())
  tenantId       String
  tenant         Tenant                 @relation(fields: [tenantId], references: [id])
  activationId   String                 @unique
  activation     PackageActivation      @relation(fields: [activationId], references: [id], onDelete: Cascade)
