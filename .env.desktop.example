# AroFi desktop Docker environment template.
# Copy values into .env.desktop.local. NEVER commit real credentials.
# .env.desktop.local is ignored by Git via .env.*.local.

# Local public app
APP_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3000
PORTAL_BASE_URL=http://localhost:3000/portal
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ADMIN_ORIGINS=http://localhost:3000

# Keep RouterOS 6.x compatible until the router fleet is upgraded.
RADIUS_REQUIRE_MESSAGE_AUTHENTICATOR=no

# -----------------------------
# Email / login OTP
# -----------------------------
SMTP_HOST=mail.arofi.net
SMTP_PORT=587
SMTP_USER=local@arofi.net
SMTP_PASS=REPLACE_WITH_REAL_LOCAL_MAILBOX_PASSWORD
SMTP_FROM_NAME=AroFi
SMTP_FROM_EMAIL=local@arofi.net
SUPPORT_EMAIL=support@arofi.net
# Keep false when mail.arofi.net has a trusted TLS certificate.
# Set true only temporarily if API logs explicitly report a self-signed certificate.
SMTP_ALLOW_SELF_SIGNED_CERT=false

# -----------------------------
# Active payment gateway: ioTec
# -----------------------------
# Technical enum stays IOTEC_PAY; customer-facing name is ioTec.
PAYMENT_GATEWAY=IOTEC_PAY
PLATFORM_PAYMENT_GATEWAY=IOTEC_PAY
IOTEC_CLIENT_ID=REPLACE_WITH_REAL_IOTEC_CLIENT_ID
IOTEC_CLIENT_SECRET=REPLACE_WITH_REAL_IOTEC_CLIENT_SECRET
IOTEC_WALLET_ID=REPLACE_WITH_REAL_IOTEC_WALLET_ID
IOTEC_IDENTITY_BASE_URL=https://id.iotec.io
IOTEC_PAY_BASE_URL=https://pay.iotec.io
IOTEC_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_IOTEC_WEBHOOK_SECRET

# Yo! Uganda remains supported. Keep its real credentials locally if you want
# to switch PAYMENT_GATEWAY=YO_UGANDA for comparison/testing.
YO_UGANDA_BASE_URL=https://paymentsapi1.yo.co.ug/ybs/task.php
YO_UGANDA_USERNAME=
YO_UGANDA_PASSWORD=
YO_UGANDA_WEBHOOK_SECRET=

# Direct MTN/Airtel integrations are placeholders until direct APIs are issued.
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=
MTN_MOMO_COLLECTION_API_USER=
MTN_MOMO_COLLECTION_API_KEY=
MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MTN_MOMO_DISBURSEMENT_API_USER=
MTN_MOMO_DISBURSEMENT_API_KEY=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_PUBLIC_KEY=

# Pesapal is not part of the approved AroFi payment-provider set.
# Do not configure Pesapal credentials on desktop or production.
