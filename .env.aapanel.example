# Copy this file to .env on the server, then replace every placeholder.
# Server folder: /www/wwwroot/arofi.arosoft.io

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=arofi_prod
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

NODE_ENV=production
PORT=3000
CORS_ALLOWED_ORIGINS=https://arofi.arosoft.io
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_JWT_SECRET
PORTAL_TOKEN_SECRET=CHANGE_ME_64_CHAR_RANDOM_PORTAL_TOKEN_SECRET
ROUTER_CREDENTIAL_SECRET=CHANGE_ME_64_CHAR_RANDOM_ROUTER_SECRET

# Payment Configuration
PAYMENT_CUSTOMER_LABEL=Pay
PAYMENT_DEFAULT_CURRENCY=UGX
MTN_COLLECTION_PROVIDER=MTN_MOMO_DIRECT
AIRTEL_COLLECTION_PROVIDER=AIRTEL_MONEY_DIRECT
MTN_DISBURSEMENT_PROVIDER=MTN_MOMO_DIRECT
AIRTEL_DISBURSEMENT_PROVIDER=AIRTEL_MONEY_DIRECT
PLATFORM_COMMISSION_BPS=0
MINIMUM_PAYOUT_UGX=0
VENDOR_WITHDRAWAL_FEE_BPS=0
VENDOR_WITHDRAWAL_FLAT_FEE_UGX=0
REQUIRE_PAYOUT_APPROVAL=true

# Temporary Pesapal collection adapter.
# To test collections before direct MTN APIs arrive, set
# MTN_COLLECTION_PROVIDER=AGGREGATOR and/or AIRTEL_COLLECTION_PROVIDER=AGGREGATOR.
# If Pesapal is configured and direct MTN/Airtel collection keys are missing,
# AROFi also falls back to AGGREGATOR automatically.
# Do not use AGGREGATOR for disbursement providers.
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3
PESAPAL_CONSUMER_KEY=CHANGE_ME_PESAPAL_CONSUMER_KEY
PESAPAL_CONSUMER_SECRET=CHANGE_ME_PESAPAL_CONSUMER_SECRET
PESAPAL_IPN_ID=CHANGE_ME_PESAPAL_IPN_ID
PESAPAL_CALLBACK_URL=https://arofi.arosoft.io/portal
# MikroTik HotSpot walled garden must allow pay.pesapal.com and *.pesapal.com
# when Pesapal is used before the customer is authenticated.

# MTN MoMo Collection API (Live)
MTN_MOMO_ENV=live
MTN_MOMO_COLLECTION_BASE_URL=https://proxy.momoapi.mtn.com
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=CHANGE_ME_MTN_COLLECTION_KEY
MTN_MOMO_COLLECTION_API_USER=CHANGE_ME_MTN_API_USER
MTN_MOMO_COLLECTION_API_KEY=CHANGE_ME_MTN_API_KEY
MTN_MOMO_TARGET_ENVIRONMENT=mtnuganda
MTN_MOMO_COLLECTION_CALLBACK_URL=https://arofi.arosoft.io/api/payments/webhooks/mtn/collection
MTN_MOMO_CURRENCY=UGX
MTN_ALLOWED_PREFIXES=077,078,076,079,031,039

# MTN MoMo Disbursement API (Live)
MTN_MOMO_DISBURSEMENT_BASE_URL=https://proxy.momoapi.mtn.com
MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=CHANGE_ME_MTN_DISBURSEMENT_KEY
MTN_MOMO_DISBURSEMENT_API_USER=CHANGE_ME_MTN_DISBURSEMENT_USER
MTN_MOMO_DISBURSEMENT_API_KEY=CHANGE_ME_MTN_DISBURSEMENT_KEY
MTN_MOMO_DISBURSEMENT_CALLBACK_URL=https://arofi.arosoft.io/api/payments/webhooks/mtn/disbursement

# Airtel Money Collection API
AIRTEL_MONEY_ENV=live
AIRTEL_MONEY_COLLECTION_BASE_URL=CHANGE_ME_AIRTEL_COLLECTION_URL
AIRTEL_MONEY_CLIENT_ID=CHANGE_ME_AIRTEL_CLIENT_ID
AIRTEL_MONEY_CLIENT_SECRET=CHANGE_ME_AIRTEL_CLIENT_SECRET
AIRTEL_MONEY_PUBLIC_KEY=CHANGE_ME_AIRTEL_PUBLIC_KEY
AIRTEL_MONEY_COUNTRY=UG
AIRTEL_MONEY_CURRENCY=UGX
AIRTEL_MONEY_COLLECTION_CALLBACK_URL=https://arofi.arosoft.io/api/payments/webhooks/airtel/collection
AIRTEL_MONEY_DISBURSEMENT_CALLBACK_URL=https://arofi.arosoft.io/api/payments/webhooks/airtel/disbursement
AIRTEL_ALLOWED_PREFIXES=070,075,074

# Airtel Money Disbursement API
AIRTEL_MONEY_DISBURSEMENT_BASE_URL=CHANGE_ME_AIRTEL_DISBURSEMENT_URL

# Email Configuration
SMTP_HOST=CHANGE_ME_SMTP_HOST
SMTP_PORT=587
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM_NAME=AROfi
SMTP_FROM_EMAIL=noreply@arofi.arosoft.io
SUPPORT_EMAIL=support@arofi.arosoft.io

# URLs
APP_BASE_URL=https://arofi.arosoft.io
ADMIN_BASE_URL=https://arofi.arosoft.io/admin
PORTAL_BASE_URL=https://arofi.arosoft.io/portal
DOCS_BASE_URL=https://arofi.arosoft.io/docs

# FreeRADIUS / MikroTik
RADIUS_SERVER_HOST=freeradius
RADIUS_PUBLIC_HOST=95.111.234.34
RADIUS_AUTH_PORT=1812
RADIUS_ACCOUNTING_PORT=1813
RADIUS_SHARED_SECRET=CHANGE_ME_RANDOM_RADIUS_SHARED_SECRET
RADIUS_INTERNAL_API_KEY=CHANGE_ME_RANDOM_RADIUS_INTERNAL_API_KEY
RADIUS_DISCONNECT_ENABLED=false
RADIUS_DISCONNECT_HOST=freeradius
RADIUS_DISCONNECT_PORT=3799
RADIUS_DISCONNECT_SECRET=CHANGE_ME_RANDOM_RADIUS_DISCONNECT_SECRET

PORTAL_PUBLIC_HOST=arofi.arosoft.io
API_PUBLIC_HOST=arofi.arosoft.io
ACCESS_WORKERS_ENABLED=true
ACCESS_WORKER_INTERVAL_MS=5000

NEXT_PUBLIC_API_URL=/api
API_SERVER_URL=http://api:3000/api
