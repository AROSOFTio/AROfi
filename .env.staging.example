# AROFi STAGING SERVER (dev.arofi.net)
# Copy to .env.staging locally only when needed. Never commit real values.
# In Coolify, create the same variables in the Environment Variables UI.

AROFI_IMAGE_TAG=staging

# --- Supabase staging project ---
# Use the Supabase Session Pooler on port 5432 for persistent IPv4 containers,
# or the direct connection if the host has working IPv6 / Supabase IPv4 add-on.
DATABASE_URL=postgresql://postgres.PROJECT_REF:CHANGE_ME@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=require
POSTGRES_HOST=aws-REGION.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_USER=postgres.PROJECT_REF
POSTGRES_PASSWORD=CHANGE_ME_SUPABASE_STAGING_PASSWORD
POSTGRES_DB=postgres
PGSSLMODE=require

# --- Staging owns migrations, workers and public webhooks ---
RUN_DB_MIGRATIONS=true
ACCESS_WORKERS_ENABLED=true
RADIUS_DB_LISTEN_ENABLED=true

# --- Public staging URLs ---
APP_BASE_URL=https://dev.arofi.net
ADMIN_BASE_URL=https://dev.arofi.net
PORTAL_BASE_URL=https://dev.arofi.net/portal
CORS_ALLOWED_ORIGINS=https://dev.arofi.net
API_PUBLIC_HOST=dev.arofi.net
PORTAL_PUBLIC_HOST=dev.arofi.net
NEXT_PUBLIC_API_URL=/api

# If staging and production share one VPS, keep staging host ports separate.
AROFI_HTTP_PORT=3006
MIKROTIK_BOOTSTRAP_HTTP_PORT=18081
RADIUS_HOST_AUTH_PORT=1912
RADIUS_HOST_ACCOUNTING_PORT=1913
WINBOX_PROXY_HOST_PORT_RANGE=32000-32100
WHATSAPP_HOST_PORT=3007

# Set this to the staging server's real public IP/hostname and port 18081.
MIKROTIK_CALLBACK_HTTP_URL=http://CHANGE_ME_STAGING_PUBLIC_IP:18081
RADIUS_SERVER_HOST=freeradius
RADIUS_PUBLIC_HOST=CHANGE_ME_STAGING_PUBLIC_IP
RADIUS_AUTH_PORT=1912
RADIUS_ACCOUNTING_PORT=1913
RADIUS_DISCONNECT_ENABLED=true
RADIUS_DISCONNECT_HOST=
RADIUS_DISCONNECT_PORT=3799
RADIUS_CLIENT_CIDR=0.0.0.0/0
# Keep compatible with the RouterOS versions actually under test.
RADIUS_REQUIRE_MESSAGE_AUTHENTICATOR=no

# --- Required application secrets: staging values only ---
JWT_SECRET=CHANGE_ME_STAGING_JWT_SECRET
PORTAL_TOKEN_SECRET=CHANGE_ME_STAGING_PORTAL_TOKEN_SECRET
ROUTER_CREDENTIAL_SECRET=CHANGE_ME_STAGING_ROUTER_SECRET
RADIUS_INTERNAL_API_KEY=CHANGE_ME_STAGING_RADIUS_INTERNAL_KEY
RADIUS_SHARED_SECRET=CHANGE_ME_STAGING_RADIUS_SHARED_SECRET
RADIUS_DISCONNECT_SECRET=CHANGE_ME_STAGING_RADIUS_DISCONNECT_SECRET
WEBHOOK_ALLOW_QUERY_SECRET=false

# --- Live payment testing ---
# These may be real/live credentials, but staging should use a dedicated test
# merchant/wallet/app where the provider supports one. Keep test amounts small.
PAYMENT_CUSTOMER_LABEL=Pay
PAYMENT_DEFAULT_CURRENCY=UGX
PLATFORM_PAYMENT_GATEWAY=YO_UGANDA
AGGREGATOR_PROVIDER=YO_UGANDA
MTN_COLLECTION_PROVIDER=AGGREGATOR
AIRTEL_COLLECTION_PROVIDER=AGGREGATOR

YO_UGANDA_BASE_URL=https://paymentsapi1.yo.co.ug/ybs/task.php
YO_UGANDA_USERNAME=CHANGE_ME_LIVE_TEST_USERNAME
YO_UGANDA_PASSWORD=CHANGE_ME_LIVE_TEST_PASSWORD
YO_UGANDA_WEBHOOK_SECRET=CHANGE_ME_STAGING_YO_WEBHOOK_SECRET
AGGREGATOR_WEBHOOK_SECRET=CHANGE_ME_STAGING_AGGREGATOR_WEBHOOK_SECRET

IOTEC_CLIENT_ID=CHANGE_ME_LIVE_TEST_CLIENT_ID
IOTEC_CLIENT_SECRET=CHANGE_ME_LIVE_TEST_CLIENT_SECRET
IOTEC_WALLET_ID=CHANGE_ME_LIVE_TEST_WALLET_ID
IOTEC_IDENTITY_BASE_URL=https://id.iotec.io
IOTEC_PAY_BASE_URL=https://pay.iotec.io
IOTEC_WEBHOOK_SECRET=CHANGE_ME_STAGING_IOTEC_WEBHOOK_SECRET

# Any provider callback/IPN configured outside AROFi must point to dev.arofi.net,
# never localhost and never production arofi.net during staging tests.
PESAPAL_CALLBACK_URL=https://dev.arofi.net/portal

# --- Email / notifications ---
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM_NAME=AROFi Staging
SMTP_FROM_EMAIL=no-reply@arofi.net
SMTP_ALLOW_SELF_SIGNED_CERT=false
SUPPORT_EMAIL=support@arofi.net

# --- Optional integrations ---
WHATSAPP_GATEWAY_API_KEY=CHANGE_ME
# Pin this to the exact same tag or digest used by production before parity sign-off.
WAHA_IMAGE=devlikeapro/waha:latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SENTRY_DSN=
