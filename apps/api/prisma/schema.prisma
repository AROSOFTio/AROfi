  password       String
  status         RadiusCredentialStatus @default(ACTIVE)
  boundMacAddress String?
  routerId       String?
  expiresAt      DateTime
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([tenantId, status, expiresAt])
  @@index([boundMacAddress, status])
}

model DeviceBindingReset {
