server default {
	listen {
		type = auth
		ipaddr = *
		port = 1812
	}

	listen {
		type = acct
		ipaddr = *
		port = 1813
	}

	authorize {
		preprocess
		chap
		files
		sql
		if ("%{sql:SELECT ch.value FROM radcheck ch JOIN \"RadiusCredential\" rc ON rc.username = ch.username JOIN \"PackageActivation\" pa ON pa.id = rc.\"activationId\" WHERE ch.username = '%{User-Name}' AND ch.attribute = 'Cleartext-Password' AND rc.status = 'ACTIVE' AND pa.status = 'ACTIVE' AND rc.\"expiresAt\" > now() AND pa.\"endsAt\" > now() ORDER BY ch.id LIMIT 1}" != "") {
			update control {
				Auth-Type := PAP
				Cleartext-Password := "%{sql:SELECT ch.value FROM radcheck ch JOIN \"RadiusCredential\" rc ON rc.username = ch.username JOIN \"PackageActivation\" pa ON pa.id = rc.\"activationId\" WHERE ch.username = '%{User-Name}' AND ch.attribute = 'Cleartext-Password' AND rc.status = 'ACTIVE' AND pa.status = 'ACTIVE' AND rc.\"expiresAt\" > now() AND pa.\"endsAt\" > now() ORDER BY ch.id LIMIT 1}"
			}
		}
		if ("%{sql:SELECT value FROM radreply WHERE username = '%{User-Name}' AND attribute = 'Session-Timeout' ORDER BY id LIMIT 1}" != "") {
			update reply {
				Session-Timeout := "%{sql:SELECT value FROM radreply WHERE username = '%{User-Name}' AND attribute = 'Session-Timeout' ORDER BY id LIMIT 1}"
			}
		}
		if ("%{sql:SELECT value FROM radreply WHERE username = '%{User-Name}' AND attribute = 'Idle-Timeout' ORDER BY id LIMIT 1}" != "") {
			update reply {
				Idle-Timeout := "%{sql:SELECT value FROM radreply WHERE username = '%{User-Name}' AND attribute = 'Idle-Timeout' ORDER BY id LIMIT 1}"
			}
		}
		if ("%{sql:SELECT value FROM radreply WHERE username = '%{User-Name}' AND attribute = 'Mikrotik-Rate-Limit' ORDER BY id LIMIT 1}" != "") {
			update reply {
				Mikrotik-Rate-Limit := "%{sql:SELECT value FROM radreply WHERE username = '%{User-Name}' AND attribute = 'Mikrotik-Rate-Limit' ORDER BY id LIMIT 1}"
			}
		}
		expiration
		logintime
		pap
	}

	authenticate {
		Auth-Type PAP {
			pap
		}
		Auth-Type CHAP {
			chap
		}
	}

	preacct {
		preprocess
		acct_unique
	}

	accounting {
		sql
	}

	session {
		sql
	}

	post-auth {
		sql
	}
}
