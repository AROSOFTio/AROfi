server inner-tunnel {
	authorize {
		chap
		files
		sql
		if ("%{sql:SELECT value FROM radcheck WHERE username = '%{User-Name}' AND attribute = 'Cleartext-Password' ORDER BY id LIMIT 1}" != "") {
			update control {
				Cleartext-Password := "%{sql:SELECT value FROM radcheck WHERE username = '%{User-Name}' AND attribute = 'Cleartext-Password' ORDER BY id LIMIT 1}"
			}
		}
		pap
	}

	authenticate {
		Auth-Type PAP {
			pap
		}
	}

	session {
		sql
	}

	post-auth {
		sql
	}
}
