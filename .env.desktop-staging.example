# AROFi DESKTOP STAGING
# Uses the SAME staging images, Supabase staging DB and live-test payment
# credentials as dev.arofi.net. Desktop is secondary: it must not own schema
# migrations or duplicate background workers/webhook processing.

AROFI_IMAGE_TAG=staging

# --- SAME Supabase staging project as dev.arofi.net ---
DATABASE_URL=postgresql://postgres.PROJECT_REF:CHANGE_ME@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=require
POSTGRES_HOST=aws-REGION.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_USER=postgres.PROJECT_REF
POSTGRES_PASSWORD=CHANGE_ME_SAME_STAGING_PASSWORD
POSTGRES_DB=postgres
PGSSLMODE=require

# Desktop is NOT the migration/worker owner for the shared staging database.
RUN_DB_MIGRATIONS=false
ACCESS_WORKERS_ENABLED=false
RADIUS_DB_LISTEN_ENABLED=false

# --- Local UI/API URLs ---
APP_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3000
PORTAL_BASE_URL=http://localhost:3000/portal
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_PUBLIC_HOST=localhost:3000
PORTAL_PUBLIC_HOST=localhost:3000
NEXT_PUBLIC_API_URL=/api

AROFI_HTTP_PORT=3000
MIKROTIK_BOOTSTRAP_HTTP_PORT=18080
RADIUS_HOST_AUTH_PORT=1812
RADIUS_HOST_ACCOUNTING_PORT=1813
WINBOX_PROXY_HOST_PORT_RANGE=31000-31100
WHATSAPP_HOST_PORT=3005

# Local FreeRADIUS container is available for local protocol checks. For a real
# remote MikroTik test, point the test router to the dev.arofi.net staging
# RADIUS public host/ports instead, because localhost is not Internet-routable.
MIKROTIK_CALLBACK_HTTP_URL=http://localhost:18080
RADIUS_SERVER_HOST=freeradius
RADIUS_PUBLIC_HOST=127.0.0.1
RADIUS_AUTH_PORT=1812
RADIUS_ACCOUNTING_PORT=1813
RADIUS_DISCONNECT_ENABLED=true
RADIUS_DISCONNECT_HOST=
RADIUS_DISCONNECT_PORT=3799
RADIUS_CLIENT_CIDR=0.0.0.0/0
RADIUS_REQUIRE_MESSAGE_AUTHENTICATOR=no

# --- SAME staging application secrets as dev.arofi.net ---
JWT_SECRET=CHANGE_ME_SAME_STAGING_JWT_SECRET
PORTAL_TOKEN_SECRET=CHANGE_ME_SAME_STAGING_PORTAL_TOKEN_SECRET
ROUTER_CREDENTIAL_SECRET=CHANGE_ME_SAME_STAGING_ROUTER_SECRET
RADIUS_INTERNAL_API_KEY=CHANGE_ME_SAME_STAGING_RADIUS_INTERNAL_KEY
RADIUS_SHARED_SECRET=CHANGE_ME_SAME_STAGING_RADIUS_SHARED_SECRET
RADIUS_DISCONNECT_SECRET=CHANGE_ME_SAME_STAGING_RADIUS_DISCONNECT_SECRET
WEBHOOK_ALLOW_QUERY_SECRET=false

# --- SAME live-test payment credentials as dev.arofi.net ---
PAYMENT_CUSTOMER_LABEL=Pay
PAYMENT_DEFAULT_CURRENCY=UGX
PLATFORM_PAYMENT_GATEWAY=YO_UGANDA
AGGREGATOR_PROVIDER=YO_UGANDA
MTN_COLLECTION_PROVIDER=AGGREGATOR
AIRTEL_COLLECTION_PROVIDER=AGGREGATOR

YO_UGANDA_BASE_URL=https://paymentsapi1.yo.co.ug/ybs/task.php
YO_UGANDA_USERNAME=CHANGE_ME_SAME_LIVE_TEST_USERNAME
YO_UGANDA_PASSWORD=CHANGE_ME_SAME_LIVE_TEST_PASSWORD
YO_UGANDA_WEBHOOK_SECRET=CHANGE_ME_SAME_STAGING_YO_WEBHOOK_SECRET
AGGREGATOR_WEBHOOK_SECRET=CHANGE_ME_SAME_STAGING_AGGREGATOR_WEBHOOK_SECRET

IOTEC_CLIENT_ID=CHANGE_ME_SAME_LIVE_TEST_CLIENT_ID
IOTEC_CLIENT_SECRET=CHANGE_ME_SAME_LIVE_TEST_CLIENT_SECRET
IOTEC_WALLET_ID=CHANGE_ME_SAME_LIVE_TEST_WALLET_ID
IOTEC_IDENTITY_BASE_URL=https://id.iotec.io
IOTEC_PAY_BASE_URL=https://pay.iotec.io
IOTEC_WEBHOOK_SECRET=CHANGE_ME_SAME_STAGING_IOTEC_WEBHOOK_SECRET

# Public provider callbacks/IPNs must remain on dev.arofi.net so the provider
# can reach them. Since desktop and dev share staging Supabase, the desktop UI
# will see the transaction state written by the dev webhook processor.
PESAPAL_CALLBACK_URL=https://dev.arofi.net/portal

# --- Email / notifications ---
SMTP_HOST=CHANGE_ME_SAME_STAGING_SMTP_HOST
SMTP_PORT=587
SMTP_USER=CHANGE_ME_SAME_STAGING_SMTP_USER
SMTP_PASS=CHANGE_ME_SAME_STAGING_SMTP_PASSWORD
SMTP_FROM_NAME=AROFi Staging
SMTP_FROM_EMAIL=no-reply@arofi.net
SMTP_ALLOW_SELF_SIGNED_CERT=false
SUPPORT_EMAIL=support@arofi.net

WHATSAPP_GATEWAY_API_KEY=CHANGE_ME_SAME_STAGING_WAHA_KEY
WAHA_IMAGE=devlikeapro/waha:latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SENTRY_DSN=
