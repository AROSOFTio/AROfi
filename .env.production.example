# AROFi PRODUCTION (arofi.net)
# This file is a variable checklist only. Never commit real production values.
# In Coolify, set the real values in the Environment Variables UI.

# REQUIRED: set this to the exact full 40-character Git SHA already tested on
# desktop + dev.arofi.net. Production then pulls the same immutable image set.
AROFI_IMAGE_TAG=CHANGE_ME_APPROVED_FULL_GIT_SHA

# --- Separate PRODUCTION Supabase project ---
DATABASE_URL=postgresql://postgres.PROJECT_REF:CHANGE_ME@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=require
POSTGRES_HOST=aws-REGION.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_USER=postgres.PROJECT_REF
POSTGRES_PASSWORD=CHANGE_ME_SUPABASE_PRODUCTION_PASSWORD
POSTGRES_DB=postgres
PGSSLMODE=require

# Production owns its own migrations and workers.
RUN_DB_MIGRATIONS=true
ACCESS_WORKERS_ENABLED=true
RADIUS_DB_LISTEN_ENABLED=true

# --- Production URLs ---
APP_BASE_URL=https://arofi.net
ADMIN_BASE_URL=https://arofi.net
PORTAL_BASE_URL=https://arofi.net/portal
CORS_ALLOWED_ORIGINS=https://arofi.net
API_PUBLIC_HOST=arofi.net
PORTAL_PUBLIC_HOST=arofi.net
NEXT_PUBLIC_API_URL=/api

# Production host bindings. Container ports remain identical to staging.
AROFI_HTTP_PORT=3000
MIKROTIK_BOOTSTRAP_HTTP_PORT=18080
RADIUS_HOST_AUTH_PORT=1812
RADIUS_HOST_ACCOUNTING_PORT=1813
WINBOX_PROXY_HOST_PORT_RANGE=31000-31100
WHATSAPP_HOST_PORT=3005

MIKROTIK_CALLBACK_HTTP_URL=http://CHANGE_ME_PRODUCTION_PUBLIC_IP:18080
RADIUS_SERVER_HOST=freeradius
RADIUS_PUBLIC_HOST=CHANGE_ME_PRODUCTION_PUBLIC_IP
RADIUS_AUTH_PORT=1812
RADIUS_ACCOUNTING_PORT=1813
RADIUS_DISCONNECT_ENABLED=true
RADIUS_DISCONNECT_HOST=
RADIUS_DISCONNECT_PORT=3799
RADIUS_CLIENT_CIDR=0.0.0.0/0
# Keep version-compatible until the router fleet is deliberately migrated.
RADIUS_REQUIRE_MESSAGE_AUTHENTICATOR=no

# --- Production-only secrets ---
JWT_SECRET=CHANGE_ME_PRODUCTION_JWT_SECRET
PORTAL_TOKEN_SECRET=CHANGE_ME_PRODUCTION_PORTAL_TOKEN_SECRET
ROUTER_CREDENTIAL_SECRET=CHANGE_ME_PRODUCTION_ROUTER_SECRET
RADIUS_INTERNAL_API_KEY=CHANGE_ME_PRODUCTION_RADIUS_INTERNAL_KEY
RADIUS_SHARED_SECRET=CHANGE_ME_PRODUCTION_RADIUS_SHARED_SECRET
RADIUS_DISCONNECT_SECRET=CHANGE_ME_PRODUCTION_RADIUS_DISCONNECT_SECRET
WEBHOOK_ALLOW_QUERY_SECRET=false

# --- Production payment credentials ---
PAYMENT_CUSTOMER_LABEL=Pay
PAYMENT_DEFAULT_CURRENCY=UGX
PLATFORM_PAYMENT_GATEWAY=YO_UGANDA
AGGREGATOR_PROVIDER=YO_UGANDA
MTN_COLLECTION_PROVIDER=AGGREGATOR
AIRTEL_COLLECTION_PROVIDER=AGGREGATOR

YO_UGANDA_BASE_URL=https://paymentsapi1.yo.co.ug/ybs/task.php
YO_UGANDA_USERNAME=CHANGE_ME_PRODUCTION_USERNAME
YO_UGANDA_PASSWORD=CHANGE_ME_PRODUCTION_PASSWORD
YO_UGANDA_WEBHOOK_SECRET=CHANGE_ME_PRODUCTION_YO_WEBHOOK_SECRET
AGGREGATOR_WEBHOOK_SECRET=CHANGE_ME_PRODUCTION_AGGREGATOR_WEBHOOK_SECRET

IOTEC_CLIENT_ID=CHANGE_ME_PRODUCTION_CLIENT_ID
IOTEC_CLIENT_SECRET=CHANGE_ME_PRODUCTION_CLIENT_SECRET
IOTEC_WALLET_ID=CHANGE_ME_PRODUCTION_WALLET_ID
IOTEC_IDENTITY_BASE_URL=https://id.iotec.io
IOTEC_PAY_BASE_URL=https://pay.iotec.io
IOTEC_WEBHOOK_SECRET=CHANGE_ME_PRODUCTION_IOTEC_WEBHOOK_SECRET

PESAPAL_CALLBACK_URL=https://arofi.net/portal

# --- Email / notifications ---
SMTP_HOST=CHANGE_ME_PRODUCTION_SMTP_HOST
SMTP_PORT=587
SMTP_USER=CHANGE_ME_PRODUCTION_SMTP_USER
SMTP_PASS=CHANGE_ME_PRODUCTION_SMTP_PASSWORD
SMTP_FROM_NAME=AROFi
SMTP_FROM_EMAIL=no-reply@arofi.net
SMTP_ALLOW_SELF_SIGNED_CERT=false
SUPPORT_EMAIL=support@arofi.net

# Pin optional infrastructure images to the SAME version/digest used in staging.
WHATSAPP_GATEWAY_API_KEY=CHANGE_ME_PRODUCTION_WAHA_KEY
WAHA_IMAGE=devlikeapro/waha:latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SENTRY_DSN=
