server inner-tunnel {
	authorize {
		chap
		files
		sql
		if ("%{sql:SELECT ch.value FROM radcheck ch JOIN \"RadiusCredential\" rc ON rc.username = ch.username JOIN \"PackageActivation\" pa ON pa.id = rc.\"activationId\" WHERE ch.username = '%{User-Name}' AND ch.attribute = 'Cleartext-Password' AND rc.status = 'ACTIVE' AND pa.status = 'ACTIVE' AND rc.\"expiresAt\" > timezone('utc', now()) AND pa.\"endsAt\" > timezone('utc', now()) ORDER BY ch.id LIMIT 1}" != "") {
			update control {
				Auth-Type := PAP
				Cleartext-Password := "%{sql:SELECT ch.value FROM radcheck ch JOIN \"RadiusCredential\" rc ON rc.username = ch.username JOIN \"PackageActivation\" pa ON pa.id = rc.\"activationId\" WHERE ch.username = '%{User-Name}' AND ch.attribute = 'Cleartext-Password' AND rc.status = 'ACTIVE' AND pa.status = 'ACTIVE' AND rc.\"expiresAt\" > timezone('utc', now()) AND pa.\"endsAt\" > timezone('utc', now()) ORDER BY ch.id LIMIT 1}"
			}
		}
		pap
	}

	authenticate {
		Auth-Type PAP {
			pap
		}
	}

	session {
		sql
	}

	post-auth {
		sql
	}
}
