{
  "name": "arofi-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "dependencies": {
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "turbo": "latest",
    "prettier": "^3.2.5"
  },
  "overrides": {
    "@nestjs/common": "11.1.21",
    "@nestjs/core": "11.1.21",
    "@nestjs/platform-express": "11.1.21",
    "file-type": "21.3.4",
    "multer": "2.1.1",
    "postcss": "8.5.14"
  },
  "packageManager": "npm@10.2.4",
  "allowScripts": {
    "@nestjs/core@11.1.21": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.28.0": true,
    "prisma@5.22.0": true,
    "sharp@0.34.5": true
  }
}
