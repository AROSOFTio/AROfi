server default {
	listen {
		type = auth
		ipaddr = *
		port = 1812
	}

	listen {
		type = acct
		ipaddr = *
		port = 1813
	}

	authorize {
		# Strip Message-Authenticator (attr 80) ONLY from localhost requests
		# (the SSTP host authenticating via pppd). pppd 2.5.2's radius.so adds
		# MA to requests, causing FreeRADIUS to mirror it in responses, and
		# pppd's old libfreeradius-client cannot validate MA in responses
		# ("invalid reply digest"). MikroTik hotspot traffic keeps its
		# Message-Authenticator intact (BlastRADIUS mitigation) — enforcement
		# for those clients is controlled per-client in clients.conf via
		# RADIUS_REQUIRE_MESSAGE_AUTHENTICATOR.
		if (Packet-Src-IP-Address == 127.0.0.1) {
			update request {
				Message-Authenticator !* ANY
			}
		}
		preprocess
		chap
		files
		sql
		# SQL-injection note: expansions inside %{sql:...} (User-Name,
		# Calling-Station-Id) are escaped by rlm_sql using the module's
		# safe_characters list (mods-available/sql), which excludes quotes —
		# attacker-controlled attribute values cannot break out of the string
		# literals below.
		if ("%{sql:SELECT ch.value FROM radcheck ch JOIN \"RadiusCredential\" rc ON rc.username = ch.username JOIN \"PackageActivation\" pa ON pa.id = rc.\"activationId\" WHERE ch.username = '%{User-Name}' AND ch.attribute = 'Cleartext-Password' AND rc.status = 'ACTIVE' AND pa.status = 'ACTIVE' AND rc.\"expiresAt\" > timezone('utc', now()) AND pa.\"endsAt\" > timezone('utc', now()) AND (rc.\"boundMacAddress\" IS NULL OR rc.\"boundMacAddress\" = '' OR UPPER(REPLACE('%{Calling-Station-Id}', '-', ':')) = '' OR rc.\"boundMacAddress\" = UPPER(REPLACE('%{Calling-Station-Id}', '-', ':'))) ORDER BY ch.id LIMIT 1}" != "") {
			update control {
				Cleartext-Password := "%{sql:SELECT ch.value FROM radcheck ch JOIN \"RadiusCredential\" rc ON rc.username = ch.username JOIN \"PackageActivation\" pa ON pa.id = rc.\"activationId\" WHERE ch.username = '%{User-Name}' AND ch.attribute = 'Cleartext-Password' AND rc.status = 'ACTIVE' AND pa.status = 'ACTIVE' AND rc.\"expiresAt\" > timezone('utc', now()) AND pa.\"endsAt\" > timezone('utc', now()) AND (rc.\"boundMacAddress\" IS NULL OR rc.\"boundMacAddress\" = '' OR UPPER(REPLACE('%{Calling-Station-Id}', '-', ':')) = '' OR rc.\"boundMacAddress\" = UPPER(REPLACE('%{Calling-Station-Id}', '-', ':'))) ORDER BY ch.id LIMIT 1}"
			}
		}
		expiration
		logintime
		pap
	}

	authenticate {
		Auth-Type PAP {
			pap
		}
		Auth-Type CHAP {
			chap
		}
	}

	preacct {
		preprocess
		acct_unique
	}

	# Accounting writes to radacct via rlm_sql. Database triggers
	# (arofi_radacct_notify / arofi_radpostauth_notify, created by the API's
	# Prisma migrations) pg_notify the AROFi API on every insert/update, so
	# session state and the admin dashboard update in realtime without
	# FreeRADIUS needing rlm_rest or any outbound HTTP.
	accounting {
		sql
	}

	session {
		sql
	}

	post-auth {
		sql
		# Strip Message-Authenticator from replies ONLY toward localhost
		# (pppd/SSTP; see the authorize note above). MikroTik replies keep it.
		if (Packet-Src-IP-Address == 127.0.0.1) {
			update reply {
				Message-Authenticator !* ANY
			}
		}
		Post-Auth-Type Reject {
			sql
			if (Packet-Src-IP-Address == 127.0.0.1) {
				update reply {
					Message-Authenticator !* ANY
				}
			}
		}
	}
}
