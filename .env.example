POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=arofi_prod
DATABASE_URL=postgresql://postgres:change_me_postgres@postgres:5432/arofi_prod?schema=public
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Offsite Postgres backups (see docs/DEPLOYMENT.md). Without BACKUP_S3_BUCKET
# set, backups still run but stay local-only on this VPS — set these before
# going live.
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ENDPOINT=
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# Yo! Uganda mobile money aggregator (collection + disbursement). This is the
# only active payment provider — payments will not work in production without
# these. MTN/Airtel direct credentials below are optional fallbacks only.
YO_UGANDA_USERNAME=
YO_UGANDA_PASSWORD=
YO_UGANDA_WEBHOOK_SECRET=
# YO_UGANDA_BASE_URL=https://paymentsapi1.yo.co.ug/ybs/task.php

# WhatsApp customer notifications (WAHA gateway, runs as the "whatsapp"
# service in docker-compose.yml). Leave WHATSAPP_GATEWAY_API_KEY blank only
# for local testing.
WHATSAPP_GATEWAY_URL=http://whatsapp:3000
WHATSAPP_GATEWAY_API_KEY=

# Error monitoring (Sentry). Leave blank to disable — the API boots and runs
# fine without it, but you won't be notified when something breaks in
# production. Get a DSN from sentry.io (free tier is enough to start).
SENTRY_DSN=

NODE_ENV=production
PORT=3000
CORS_ALLOWED_ORIGINS=https://admin.example.com,https://portal.example.com
JWT_SECRET=replace_with_32plus_random_chars
PORTAL_TOKEN_SECRET=replace_with_different_32plus_random_chars
ROUTER_CREDENTIAL_SECRET=replace_with_32plus_random_chars

# Payment Configuration
PAYMENT_CUSTOMER_LABEL=Pay
PAYMENT_DEFAULT_CURRENCY=UGX
MTN_COLLECTION_PROVIDER=MTN_MOMO_DIRECT
AIRTEL_COLLECTION_PROVIDER=AIRTEL_MONEY_DIRECT
MTN_DISBURSEMENT_PROVIDER=MTN_MOMO_DIRECT
AIRTEL_DISBURSEMENT_PROVIDER=AIRTEL_MONEY_DIRECT
PLATFORM_COMMISSION_BPS=0
MINIMUM_PAYOUT_UGX=0
VENDOR_WITHDRAWAL_FEE_BPS=0
VENDOR_WITHDRAWAL_FLAT_FEE_UGX=0
REQUIRE_PAYOUT_APPROVAL=true

# Temporary Pesapal collection adapter.
# To route customer MTN/Airtel collections through Pesapal while waiting for direct
# MTN APIs, set MTN_COLLECTION_PROVIDER=AGGREGATOR and/or
# AIRTEL_COLLECTION_PROVIDER=AGGREGATOR. If Pesapal is configured and direct
# MTN/Airtel collection keys are missing, AROFi also falls back to AGGREGATOR.
# Customer screens still show only MTN, Airtel, and Pay.
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
PESAPAL_CALLBACK_URL=https://arofi.arosoft.io/portal
# MikroTik HotSpot walled garden must allow pay.pesapal.com and *.pesapal.com
# when Pesapal is used before the customer is authenticated.

# MTN MoMo Collection API
MTN_MOMO_ENV=sandbox
MTN_MOMO_COLLECTION_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=
MTN_MOMO_COLLECTION_API_USER=
MTN_MOMO_COLLECTION_API_KEY=
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_COLLECTION_CALLBACK_URL=https://arofi.arosoft.io/api/payments/webhooks/mtn/collection
MTN_MOMO_CURRENCY=UGX
MTN_ALLOWED_PREFIXES=077,078,076,079,031,039

# MTN MoMo Disbursement API
MTN_MOMO_DISBURSEMENT_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MTN_MOMO_DISBURSEMENT_API_USER=
MTN_MOMO_DISBURSEMENT_API_KEY=
MTN_MOMO_DISBURSEMENT_CALLBACK_URL=https://arofi.arosoft.io/api/payments/webhooks/mtn/disbursement

# Airtel Money Collection API
AIRTEL_MONEY_ENV=sandbox
AIRTEL_MONEY_COLLECTION_BASE_URL=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_PUBLIC_KEY=
AIRTEL_MONEY_COUNTRY=UG
AIRTEL_MONEY_CURRENCY=UGX
AIRTEL_MONEY_COLLECTION_CALLBACK_URL=https://arofi.arosoft.io/api/payments/webhooks/airtel/collection
AIRTEL_MONEY_DISBURSEMENT_CALLBACK_URL=https://arofi.arosoft.io/api/payments/webhooks/airtel/disbursement
AIRTEL_ALLOWED_PREFIXES=070,075,074

# Airtel Money Disbursement API
AIRTEL_MONEY_DISBURSEMENT_BASE_URL=

# Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=AROfi
SMTP_FROM_EMAIL=no-reply@arofi.net
SUPPORT_EMAIL=support@arofi.arosoft.io

# Subscription plan renewal reminder emails (sendSubscriptionExpiryReminderEmail)
SUBSCRIPTION_EXPIRY_REMINDERS_ENABLED=true
SUBSCRIPTION_EXPIRY_REMINDER_INTERVAL_MS=21600000

# WhatsApp gateway (WAHA - self-hosted WhatsApp Web bridge), used for the
# admin live-chat widget AND customer payment/voucher confirmations
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_API_KEY=
ROUTER_ALERTS_WHATSAPP_PHONE=

# URLs
APP_BASE_URL=https://arofi.arosoft.io
ADMIN_BASE_URL=https://arofi.arosoft.io/admin
PORTAL_BASE_URL=https://arofi.arosoft.io/portal
DOCS_BASE_URL=https://arofi.arosoft.io/docs

RADIUS_SERVER_HOST=freeradius
RADIUS_PUBLIC_HOST=radius.example.com
RADIUS_AUTH_PORT=1812
RADIUS_ACCOUNTING_PORT=1813
RADIUS_SHARED_SECRET=bootstrap-only-use-router-specific-secrets
RADIUS_INTERNAL_API_KEY=replace_with_random_internal_key
RADIUS_DISCONNECT_ENABLED=true
# Leave RADIUS_DISCONNECT_HOST blank — Disconnect-Request (CoA) must go to each
# MikroTik router's own NAS IP, not the FreeRADIUS container. The app resolves
# the target per-router (router.radiusNasIpAddress) when this is left empty.
RADIUS_DISCONNECT_HOST=
RADIUS_DISCONNECT_PORT=3799
RADIUS_DISCONNECT_SECRET=replace_with_router_disconnect_secret_when_enabled
# Optional standby FreeRADIUS host on the same RADIUS_SHARED_SECRET. If set,
# every router's provisioning script adds it as a second RADIUS entry —
# MikroTik fails over to it automatically if the primary stops responding.
# Leave blank unless you've actually stood up a second FreeRADIUS instance.
RADIUS_SECONDARY_HOST=

PORTAL_PUBLIC_HOST=portal.example.com
API_PUBLIC_HOST=api.example.com
ACCESS_WORKERS_ENABLED=true
ACCESS_WORKER_INTERVAL_MS=5000

NEXT_PUBLIC_API_URL=/api
API_SERVER_URL=http://api:3000/api
