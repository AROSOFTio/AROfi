sql {
	driver = "rlm_sql_postgresql"
	dialect = "postgresql"
	server = "postgres"
	port = 5432
	login = "${env:POSTGRES_USER:-postgres}"
	password = "${env:POSTGRES_PASSWORD:-root}"
	radius_db = "${env:POSTGRES_DB:-arofi_dev}"
	read_clients = no
	client_table = "nas"
	delete_stale_sessions = yes
	pool {
		start = 5
		min = 3
		max = 10
		spare = 3
		uses = 0
		lifetime = 0
		idle_timeout = 60
	}
}
