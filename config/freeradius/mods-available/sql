sql {
	driver = "rlm_sql_postgresql"
	dialect = "postgresql"
	server = "postgres"
	port = 5432
	login = "$ENV{POSTGRES_USER}"
	password = "$ENV{POSTGRES_PASSWORD}"
	radius_db = "$ENV{POSTGRES_DB}"
	read_clients = yes
	client_table = "nas"
	delete_stale_sessions = yes
	pool {
		start = 5
		min = 3
		max = 10
		spare = 3
		uses = 0
		lifetime = 0
		idle_timeout = 60
	}
}
